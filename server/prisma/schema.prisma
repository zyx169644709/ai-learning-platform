generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id                 String              @id @default(cuid())
  username           String              @unique
  email              String              @unique
  password           String
  bio                String?
  avatar             String?
  status             String              @default("active")
  lastLoginAt        DateTime?           @map("last_login_at")
  role               UserRole            @default(USER)
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  chapters           Chapter[]
  commentLikes       CommentLike[]
  comments           Comment[]
  courses            Course[]
  discussionLikes    DiscussionLike[]
  discussions        Discussion[]
  favorites          Favorite[]
  resources          Resource[]
  userPreferences    UserPreferences?
  courseCompletions  CourseCompletion[]
  sectionCompletions SectionCompletion[]

  @@index([email])
  @@index([username])
  @@map("users")
}

model UserPreferences {
  id             String   @id @default(cuid())
  userId         String   @unique @map("user_id")
  theme          String   @default("dark")
  codePanelRatio Int      @default(50) @map("code_panel_ratio")
  language       String   @default("javascript")
  notifications  Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model Discussion {
  id              String             @id @default(cuid())
  title           String
  content         String
  category        DiscussionCategory
  status          String             @default("published")
  isPinned        Boolean            @default(false) @map("is_pinned")
  views           Int                @default(0)
  likes           Int                @default(0)
  authorId        String             @map("author_id")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  comments        Comment[]
  discussionLikes DiscussionLike[]
  author          User               @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([isPinned])
  @@map("discussions")
}

model Comment {
  id           String        @id @default(cuid())
  content      String
  status       String        @default("visible")
  likes        Int           @default(0)
  authorId     String        @map("author_id")
  discussionId String        @map("discussion_id")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  commentLikes CommentLike[]
  discussion   Discussion    @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  author       User          @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("comments")
}

model DiscussionLike {
  id           String     @id @default(cuid())
  userId       String     @map("user_id")
  discussionId String     @map("discussion_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  discussion   Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, discussionId])
  @@index([discussionId])
  @@map("discussion_likes")
}

model CommentLike {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  commentId String   @map("comment_id")
  createdAt DateTime @default(now()) @map("created_at")
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@index([commentId])
  @@map("comment_likes")
}

model Course {
  id            String     @id @default(cuid())
  title         String
  level         String?
  category      String?
  cover         String?
  url           String
  status        String     @default("draft")
  duration      String?
  content       String?
  order         Int        @default(0)
  authorId      String?    @map("author_id")
  viewCount     Int        @default(0)
  studentCount  Int        @default(0)
  favoriteCount Int        @default(0)
  tags          Json?
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  author        User?      @relation(fields: [authorId], references: [id])
  favorites     Favorite[]

  @@index([authorId])
  @@index([level])
  @@index([category])
  @@index([status])
  @@index([order])
  @@map("courses")
}

model Chapter {
  id            String     @id @default(cuid())
  title         String
  content       String?
  excerpt       String?
  type          String     @default("section")
  order         Int        @default(0)
  duration      String?
  videoUrl      String?    @map("video_url")
  status        String     @default("draft")
  parentId      String?    @map("parent_id")
  authorId      String?    @map("author_id")
  viewCount     Int        @default(0)
  favoriteCount Int        @default(0)
  tags          Json?
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  author        User?      @relation(fields: [authorId], references: [id])
  parent        Chapter?   @relation("ChapterHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children      Chapter[]  @relation("ChapterHierarchy")
  favorites     Favorite[]
  sectionCompletions SectionCompletion[]

  @@index([parentId])
  @@index([type])
  @@index([order])
  @@index([status])
  @@map("chapters")
}

model Resource {
  id            String     @id @default(cuid())
  title         String
  description   String?
  cover         String?
  icon          String?
  url           String
  type          String     @default("website")
  status        String     @default("draft")
  authorId      String?    @map("author_id")
  viewCount     Int        @default(0)
  likeCount     Int        @default(0)
  favoriteCount Int        @default(0)
  tags          Json?
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  favorites     Favorite[]
  author        User?      @relation(fields: [authorId], references: [id])

  @@index([type])
  @@index([status])
  @@map("resources")
}

model Favorite {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  targetType String    @map("target_type")
  courseId   String?   @map("course_id")
  chapterId  String?   @map("chapter_id")
  resourceId String?   @map("resource_id")
  createdAt  DateTime  @default(now()) @map("created_at")
  resource   Resource? @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  chapter    Chapter?  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  course     Course?   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, courseId])
  @@unique([userId, targetType, chapterId])
  @@unique([userId, targetType, resourceId])
  @@index([userId])
  @@index([targetType])
  @@map("favorites")
}

enum UserRole {
  USER
  ADMIN
  MODERATOR
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum DiscussionCategory {
  TECH
  EXPERIENCE
  PROJECT
  HELP
}

model CourseCompletion {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  courseId    String   @map("course_id")
  completedAt DateTime @default(now()) @map("completed_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@map("course_completions")
}

model SectionCompletion {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  sectionId   String   @map("section_id")
  completedAt DateTime @default(now()) @map("completed_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  section     Chapter  @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([userId, sectionId])
  @@index([userId])
  @@index([sectionId])
  @@map("section_completions")
}
